# =============================================================================
#  Copy this file to .env and fill in the values:   cp .env.example .env
#  It is read by docker compose, the scripts in scripts/ and the mediaserver-*
#  commands. Format: KEY=value, no spaces around "=" and no trailing comments.
#  Wrap values containing spaces or special characters in quotes.
# =============================================================================

# --- General -----------------------------------------------------------------
# UID/GID of the user that owns the files (check with: id)
PUID=1000
PGID=1000
TZ=Europe/Madrid

# Drive or directory holding all media. Expected subdirectories:
#   movies/  tv/  torrents/complete/  torrents/incomplete/
MEDIA_ROOT=/mnt/media

# Where containers store their configuration (relative to the repository root)
CONFIG_DIR=./docker/config

# --- Remote access -----------------------------------------------------------
# Public hostname pointing to your IP (e.g. from dynv6.com, DuckDNS...)
DOMAIN=yourdomain.dynv6.net
# The server's LAN IP address (check with: hostname -I)
SERVER_IP=192.168.1.10

# dynv6 zone and token for scripts/dynv6.sh
DYNV6_ZONE=yourdomain.dynv6.net
DYNV6_TOKEN=

# Public WireGuard UDP port and number of client configs (peers) to generate
WG_PORT=51820
WG_PEERS=1

# --- Service passwords -------------------------------------------------------
AMULE_WEBUI_PASSWORD=change_me
AMULE_GUI_PASSWORD=change_me

# Username/password for the Samba (SMB) network share
SAMBA_USER=media
SAMBA_PASSWORD=change_me
SAMBA_SHARE=media
SAMBA_NETBIOS_NAME=MEDIASERVER

# --- qBittorrent (used by the scraper) ---------------------------------------
QB_URL=http://localhost:8080/api/v2
QB_USER=admin
QB_PASS=

# --- AI organizer (OpenRouter) -----------------------------------------------
# Create a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model to try first (optional, recommended: leave empty). Free models are
# discovered and chosen automatically; see "How the model is chosen" in README.md
OPENROUTER_MODEL=
# Last resort: OpenRouter router that spreads requests across free models
OPENROUTER_FALLBACK=openrouter/free

# Error notifications to your phone via https://ntfy.sh (optional).
# Use a long, hard-to-guess topic name: anyone who knows it can read it.
NTFY_TOPIC=

# --- Optional ----------------------------------------------------------------
# Mount points that start.sh waits for before starting Docker (defaults to MEDIA_ROOT)
#WAIT_FOR_MOUNTS=/mnt/media
# Run scripts/optimize.sh at boot (requires passwordless sudo)
RUN_OPTIMIZE=false
# Organizer state directory (relative to the repository root)
#DATA_DIR=data
# Custom paths if you don't follow the MEDIA_ROOT layout
#TORRENTS_COMPLETE_DIR=/mnt/media/torrents/complete
#TV_DIR=/mnt/media/tv
#MOVIES_DIR=/mnt/media/movies
# Scraper
#SCRAPER_HOST=0.0.0.0
#SCRAPER_PORT=5000
#CF_BYPASS_BASE=http://127.0.0.1:8000
#CF_BYPASS_TIMEOUT=180
#CF_BYPASS_RETRIES=5
#CF_BYPASS_BYPASS_CACHE=false
#ECH_DOH_URL=https://1.1.1.1/dns-query
#SCRAPE_PLAYWRIGHT_FALLBACK=1
#SCRAPE_SAVE_LAST_HTML=/tmp/last.html
